<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Chronicle.Plugin.Steam</AssemblyName>
    <RootNamespace>Chronicle.Plugin.Steam</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Chronicle Contributors</Authors>
    <Description>Steam plugin for Chronicle: imports your whole Steam library (owned games, playtime, wishlist, level, badges) and fetches Steam store metadata and achievements. Needs a free Steam Web API key.</Description>
  </PropertyGroup>

  <!-- Chronicle.Plugins.dll is provided by the host at runtime: do NOT copy it to the output. -->
  <ItemGroup>
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.*" />
    <PackageReference Include="Serilog" Version="4.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="Chronicle.Plugin.Steam.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
